# (Berkas .env dibuat otomatis dari berkas ini saat aplikasi pertama kali dijalankan.)
# Salin berkas ini menjadi `.env` di folder proyek (sejajar main.py). Program memuatnya OTOMATIS
# (butuh `pip install python-dotenv`); variabel yang sudah diatur di terminal tidak ditimpa.
# Hapus tanda # di depan baris yang ingin dipakai. Biarkan semua tertutup untuk mode offline.
# ANTHROPIC_API_KEY=sk-ant-...
# CHATBOT_LLM_MODEL=claude-sonnet-5-5
# CHATBOT_KB_PATH=akademikbot/data/knowledge_base.json
# CHATBOT_LOG_PATH=logs/chat_log.jsonl
# CHATBOT_LOG=0                     # 0 = matikan log percakapan

# Multi-model (python main.py --multi): isi key yang dimiliki saja
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...                # atau GOOGLE_API_KEY
# CHATBOT_GPT_MODEL=gpt-4o-mini     # verifikasi nama model di dashboard penyedia
# CHATBOT_GEMINI_MODEL=gemini-2.5-flash
# CHATBOT_VERIFIKASI=1              # model lain memverifikasi jawaban (+1 panggilan)
# CHATBOT_DATA_DIR=akademikbot/data   # folder kurikulum.json, jadwal.csv, jadwal_info.json, info_umum.json
# CHATBOT_FEEDBACK_PATH=logs/feedback_negatif.jsonl   # log rating 👎 dari antarmuka web
